+// kiểm tra khí ở miệng ống
+function drawTest(ux, ut, id, gas){
+  if (S.testP <= 0.01) return;
+  const { ctx, X, Y, C, sc } = g, p = S.testP, done = p > 0.97;
+  if (S.test === 'ember' || S.test === 'dead'){
