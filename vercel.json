{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:mon(vat-li|hoa-hoc|sinh-hoc)",
      "destination": "/subject.html"
    },
    {
      "source": "/:mon(vat-li|hoa-hoc|sinh-hoc)/:bai",
      "destination": "/lab.html"
    }
  ],
  "redirects": [
    {
      "source": "/thau-kinh/:path*",
      "destination": "/vat-li/thau-kinh",
      "permanent": true
    },
    {
      "source": "/toc-do-phan-ung/:path*",
      "destination": "/hoa-hoc/toc-do-phan-ung",
      "permanent": true
    },
    {
      "source": "/quang-hop/:path*",
      "destination": "/sinh-hoc/quang-hop",
      "permanent": true
    }
  ]
}
