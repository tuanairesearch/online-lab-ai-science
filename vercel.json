{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:mon(vat-li|hoa-hoc|sinh-hoc)",
      "destination": "/subject.html"
    }
  ]
}
