# Sao chép file này thành .env.local khi chạy thử trên máy (vercel dev).
# Trên Vercel: Project Settings → Environment Variables.

# Bắt buộc: API key lấy ở https://aistudio.google.com (mục Get API key)
GEMINI_API_KEY=

# Không bắt buộc: tên model Gemini. Mặc định: gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-lite-latest

# Không bắt buộc: model dự phòng khi model chính quá tải/chậm. Mặc định: gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Không bắt buộc: thêm tên miền khác được phép gọi API (cách nhau dấu phẩy)
# ALLOWED_ORIGINS=https://ten-mien-cua-ban.vn
